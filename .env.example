# ==========================================
# BOOK ME EVENTS - ENVIRONMENT VARIABLES
# ==========================================
# DO NOT COMMIT THIS FILE WITH REAL CREDENTIALS
# Copy to .env and fill with actual values

# ==================== NODE ====================
NODE_ENV=production
PORT=5000

# ==================== DATABASE ====================
# MongoDB connection string with credentials
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URI=mongodb+srv://user:password@cluster.aqmb6vi.mongodb.net/database

# ==================== JWT AUTHENTICATION ====================
# IMPORTANT: Use a strong, random secret (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_secret_key_min_32_chars_long_not_this

# OTP expiry in minutes
JWT_OTP_EXPIRE_MINUTES=10

# Reset token expiry in minutes
JWT_RESET_EXPIRE_MINUTES=15

# ==================== FRONTEND ====================
# Frontend URL for password reset links, CORS, etc.
FRONTEND_URL=https://bookmeevent.netlify.app

# ==================== EMAIL CONFIGURATION ====================
# SMTP configuration for sending emails (OTP, password reset, notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
MAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your_gmail_app_password_here

# Sender name for emails
SMTP_FROM=Book Me Events

# ==================== CLOUDINARY FILE UPLOADS ====================
# For image uploads (profile pictures, service images, KYC docs)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==================== PAYMENT GATEWAYS ====================

# --- Flutterwave Configuration ---
# Flutterwave keys (use LIVE keys in production, TEST in development)
FLW_SECRET_KEY=FLWSECK_LIVE-xxxxxxxxxxxxx
FLW_PUBLIC_KEY=FLWPUBK_LIVE-xxxxxxxxxxxxx
FLW_WEBHOOK_SECRET=your_webhook_secret_key
FLW_ENCRYPTION_KEY=your_encryption_key

# --- Stripe Configuration (Optional) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_PUBLIC_KEY=pk_live_xxxxxxxxxxxxx

# ==================== SECURITY ====================
# Set to "production" to enable strict security headers
# Stack traces disabled in production
APP_NAME=Book Me Events

# Email locale for email templates
EMAIL_LOCALE=en-NG
